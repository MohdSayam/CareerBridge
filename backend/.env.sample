# ─────────────────────────────────────────────────────────────────────────────
# CareerBridge Backend — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# SETUP INSTRUCTIONS:
#   1. Copy this file: cp .env.sample .env
#   2. Fill in every value below with your own credentials
#   3. NEVER commit your .env file to git (it is already in .gitignore)
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# Free tier: https://neon.tech → Create project → copy the connection string
DATABASE_URL=postgresql://user:password@hostname/dbname?sslmode=require

# ── Flask Security ────────────────────────────────────────────────────────────
FLASK_ENV=production
SECRET_KEY=replace-with-a-long-random-string
JWT_SECRET_KEY=replace-with-another-long-random-string

# ── Redis / Celery ────────────────────────────────────────────────────────────
# Free tier: https://upstash.com → Create Redis database → copy REST URL
# Use rediss:// (with double-s) for TLS/SSL connections (required by Upstash)
REDIS_HOST=localhost
REDIS_PORT=6379
CELERY_BROKER_URL=rediss://default:your-upstash-password@your-upstash-host.upstash.io:6379
CELERY_RESULT_BACKEND=rediss://default:your-upstash-password@your-upstash-host.upstash.io:6379

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Free tier: https://brevo.com → SMTP & API → Generate SMTP Key
# Free plan gives 300 emails/day which is plenty for a college project
MAIL_SERVER=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your-brevo-smtp-login@smtp-brevo.com
MAIL_PASSWORD=your-brevo-smtp-key
MAIL_DEFAULT_SENDER=your-email@gmail.com

# ── Google OAuth ──────────────────────────────────────────────────────────────
# https://console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0
# Add your Vercel URL as an authorized JavaScript origin
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Admin Account (seeded on first run) ──────────────────────────────────────
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=StrongPassword@123

# ── Cloudinary (Resume & Profile Image Storage) ───────────────────────────────
# Free tier: https://cloudinary.com → Dashboard → copy the CLOUDINARY_URL
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# ── App URL ───────────────────────────────────────────────────────────────────
# Your deployed frontend URL (used for email links and CORS)
APP_BASE_URL=http://localhost:5173
