# ─────────────────────────────────────────────
# CareerBridge — Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env to git
# ─────────────────────────────────────────────

# Database (PostgreSQL — use Neon.tech for free)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Flask
FLASK_ENV=production
SECRET_KEY=your-random-secret-key-here-min-32-chars
JWT_SECRET_KEY=your-random-jwt-secret-here-min-32-chars

# Admin account (auto-created on first run)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=Admin@SecurePass123

# Redis / Celery (use Upstash for free cloud Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Email (Brevo free tier — 300 emails/day)
MAIL_SERVER=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your_brevo_login_email
MAIL_PASSWORD=your_brevo_smtp_api_key
MAIL_DEFAULT_SENDER=noreply@yourdomain.com

# Google OAuth (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Cloudinary (file uploads — free tier)
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# App base URL (used in email links — change to your deployed frontend URL)
APP_BASE_URL=http://localhost:5173

