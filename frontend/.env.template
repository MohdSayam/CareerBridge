# ─────────────────────────────────────────────
# CareerBridge Frontend — Environment Variables
# Copy to .env.local and fill in values
# NEVER commit .env.local to git
# ─────────────────────────────────────────────

# Backend API base URL
# Local dev: http://localhost:5000/api
# Production (Render): https://your-app.onrender.com/api
VITE_API_BASE_URL=http://localhost:5000/api

# Google OAuth Client ID (same as backend)
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# WebRTC STUN/TURN Server (Optional but recommended for production)
# Example: Metered.ca provides a free TURN server
VITE_TURN_SERVER=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
